# PostgreSQL connection string (Neon or compatible)
NETLIFY_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT Secret for player tokens (dev only - production uses Netlify env var)
JWT_SECRET=generate-a-random-64-char-hex-string

# Client-side error monitoring sampling rate (0..1, default 1)
VITE_ERROR_MONITORING_SAMPLE_RATE=1
