# PostgreSQL connection string (Neon or compatible)
NETLIFY_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT Secret for player tokens (dev only - production uses Netlify env var)
JWT_SECRET=generate-a-random-64-char-hex-string

# Client-side error monitoring sampling rate (0..1, default 1)
VITE_ERROR_MONITORING_SAMPLE_RATE=1

# CARTO basemap API key — free (5M tile requests/month): https://carto.com/basemaps/apikey
# Required: without it CARTO answers 200 with "API KEY REQUIRED" watermarked tiles.
# It is public by design (sent as a `key` query param in the tile URL), but it is
# per-customer: never reuse another project's key and keep the map attribution visible.
VITE_CARTO_API_KEY=
