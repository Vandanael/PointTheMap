{
  "compilerOptions": {
    "checkJs": true,
    "strict": false,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "module": "ES2022",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "maxNodeModuleJsDepth": 0,
    "allowImportingTsExtensions": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@lib/*": ["./lib/*"]
    }
  },
  "include": ["src/**/*", "lib/**/*", "netlify/functions/**/*", "src/vite-env.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "test-results",
    "tests/e2e",
    "**/*.test.js",
    "src/**/*.test.js",
    "lib/**/*.test.js",
    "netlify/**/*.test.js"
  ]
}
