{
  "name": "pointthemap",
  "version": "1.0.0",
  "type": "module",
  "description": "Point The Map - Geography game",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run check:budget",
    "check:budget": "node scripts/check-bundle-budget.js",
    "preview": "vite preview",
    "test": "vitest",
    "typecheck": "tsc -p jsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:dev": "E2E_MODE=dev playwright test",
    "e2e:preview": "E2E_MODE=preview playwright test",
    "generate:start-screen": "node scripts/generate-start-screen-images.js",
    "optimize:geojson": "node scripts/optimize-countries-geojson.js",
    "optimize:civilizations": "node scripts/optimize-civilizations-geojson.js",
    "measure:geojson": "node scripts/measure-geojson-size.js"
  },
  "dependencies": {
    "@netlify/functions": "^3.0.0",
    "@netlify/neon": "^0.1.2",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@turf/simplify": "^7.3.3",
    "@turf/union": "^7.3.3",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.3.9",
    "playwright": "^1.58.2",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "tar": "^7.5.6",
    "lodash": "^4.17.23",
    "lodash-es": "^4.17.23"
  }
}
